{
  "$schema": "gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Renderer allow-list for the Jait desktop shell",
  "windows": ["main"],
  "local": true,
  "remote": {
    "urls": [
      "http://localhost:*/*",
      "http://127.0.0.1:*/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
    "allow-desktop-ipc",
    "allow-desktop-pick-directory-dialog",
    "allow-window-minimize",
    "allow-window-toggle-maximize",
    "allow-window-close",
    "allow-window-is-maximized",
    "allow-window-start-drag",
    "allow-open-project-window",
    "allow-desktop-get-login-item",
    "allow-desktop-set-login-item",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "dialog:allow-open",
    "opener:default",
    "os:default",
    "notification:default"
  ]
}