{
  "name": "@jait/gateway",
  "version": "0.1.918",
  "description": "Jait AI gateway \u2014 local-first AI coding agent with terminal, filesystem, and browser control",
  "author": "JakobWl",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "jait": "./bin/jait.mjs"
  },
  "files": [
    "dist",
    "bin",
    "web-dist",
    "skills"
  ],
  "scripts": {
    "prebuild": "bun run --filter @jait/web build && bun run bundle-web",
    "bundle-web": "node scripts/bundle-web.mjs",
    "build": "node scripts/embed-shell-integration.mjs && tsc && node scripts/copy-shell-integration.mjs",
    "copy-assets": "node scripts/copy-shell-integration.mjs",
    "embed-shell-integration": "node scripts/embed-shell-integration.mjs",
    "dev": "bun run --filter @jait/web build && bun --watch src/index.ts",
    "start": "node ./bin/jait.mjs",
    "postinstall": "node ./bin/install-runtime.mjs",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "agent",
    "coding",
    "gateway",
    "terminal",
    "local-first"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Widev-e-U/Jait.git",
    "directory": "packages/gateway"
  },
  "homepage": "https://jait.dev",
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.87.0",
    "@agentclientprotocol/codex-acp": "2.1.1",
    "@agentclientprotocol/sdk": "^1.7.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^9.3.0",
    "@fastify/websocket": "^11.3.3",
    "@jait/screen-share": "workspace:*",
    "@jait/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@parcel/watcher": "^2.6.0",
    "baileys": "^7.0.0-rc14",
    "bun-pty": "^0.4.11",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.3",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.5",
    "jose": "^6.2.12",
    "nanoid": "^5.1.16",
    "node-pty": "^1.1.0",
    "pino": "^9.14.0",
    "playwright": "^1.64.0",
    "qrcode": "^1.5.4",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3"
  }
}
