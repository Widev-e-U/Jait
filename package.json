{
  "name": "jait",
  "version": "0.1.82",
  "private": true,
  "type": "module",
  "description": "Just Another Intelligent Tool \u2014 AI-assisted network and cybersecurity",
  "license": "MIT",
  "author": "JakobWl",
  "homepage": "https://jait.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/Widev-e-U/Jait"
  },
  "keywords": [
    "ai",
    "agent",
    "cybersecurity",
    "local-first",
    "terminal",
    "network-security"
  ],
  "workspaces": [
    "packages/*",
    "apps/*",
    "extensions/*",
    "skills/*"
  ],
  "scripts": {
    "build:local": "bash scripts/build-local.sh",
    "deploy:local": "bash scripts/local-deploy.sh",
    "test:local-deploy": "node --test scripts/local-deploy.test.mjs",
    "build": "bun run --filter '!@jait/web' build",
    "dev": "bun run --filter '*' dev",
    "test": "vitest run",
    "test:contract": "node tests/contract/run.mjs run",
    "test:contract:internal": "node tests/contract/run.mjs internal",
    "test:contract:unit": "node tests/contract/run.mjs test",
    "test:contract:source": "node tests/contract/run.mjs source-review",
    "test:contract:fmt": "node tests/contract/run.mjs fmt",
    "test:contract:lint": "node tests/contract/run.mjs clippy --all-targets -- -D warnings",
    "test:e2e": "npm --prefix tests/e2e test --",
    "test:e2e:ui": "npm --prefix tests/e2e test -- --config playwright.ui.config.ts",
    "test:smoke": "npm --prefix tests/e2e test -- core-basics.spec.ts manager-pages.spec.ts chat-streaming-auth.spec.ts message-attachment-regressions.spec.ts security-workbench.spec.ts conversation-viewport-layout.spec.ts",
    "test:watch": "vitest",
    "test:tools": "vitest run packages/gateway/src/tools --reporter=verbose",
    "test:tools:browser": "JAIT_BROWSER_INTEGRATION=1 vitest run packages/gateway/src/tools/browser-tools-integration.test.ts --reporter=verbose",
    "lint": "bunx oxlint . && bun run lint:hooks",
    "lint:hooks": "bunx oxlint --react-plugin --allow all --deny react/rules-of-hooks apps/web/src",
    "typecheck": "bun run --filter '*' typecheck",
    "release": "node scripts/release.mjs",
    "release:check": "node scripts/check-release-version-source.js",
    "check:artifacts": "node scripts/check-artifact-paths.mjs",
    "healthcheck": "bun run release:check && bun run check:artifacts && bun run typecheck && bun run build && bun run test && bun run lint",
    "clean": "rm -rf packages/*/dist apps/*/dist node_modules/.cache",
    "test:contract:coverage": "node tests/contract/run.mjs coverage",
    "test:contract:translated": "node tests/contract/run.mjs translated-report",
    "test:contract:matcher-differential": "node tests/contract/tooling/matcher-differential.mjs",
    "test:contract:interfaces": "node tests/contract/tooling/capture-interfaces.mjs",
    "test:contract:interfaces:check": "node tests/contract/tooling/capture-interfaces.mjs --check",
    "dev:gateway:rust": "node packages/gateway-rust/run.mjs run",
    "build:gateway:rust": "node packages/gateway-rust/run.mjs build",
    "test:gateway:rust": "node packages/gateway-rust/tooling/check-native.mjs",
    "test:gateway:migration": "node tests/contract/migration.mjs",
    "test:gateway:migration:types": "tsc --project tests/contract/tsconfig.migration.json --noEmit"
  },
  "devDependencies": {
    "@vitest/coverage-istanbul": "3.2.7",
    "@vitest/coverage-v8": "3.2.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "trustedDependencies": [
    "node-pty",
    "@matrix-org/matrix-sdk-crypto-nodejs"
  ],
  "overrides": {
    "@types/node": "^26.4.1",
    "@matrix-org/matrix-sdk-crypto-nodejs": "0.6.1"
  },
  "patchedDependencies": {
    "@agentclientprotocol/codex-acp@2.1.1": "patches/@agentclientprotocol%2Fcodex-acp@2.1.1.patch"
  }
}
