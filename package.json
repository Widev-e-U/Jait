{
  "name": "jait",
  "version": "0.1.82",
  "private": true,
  "type": "module",
  "description": "Just Another Intelligent Tool \u2014 AI-assisted network and cybersecurity",
  "license": "MIT",
  "author": "JakobWl",
  "homepage": "https://jait.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/Widev-e-U/Jait"
  },
  "keywords": [
    "ai",
    "agent",
    "cybersecurity",
    "local-first",
    "terminal",
    "network-security"
  ],
  "workspaces": [
    "packages/*",
    "apps/*",
    "extensions/*",
    "skills/*"
  ],
  "scripts": {
    "build": "bun run --filter '!@jait/web' build",
    "dev": "bun run --filter '*' dev",
    "test": "vitest run",
    "test:e2e": "npm --prefix tests/e2e test",
    "test:watch": "vitest",
    "test:tools": "vitest run packages/gateway/src/tools --reporter=verbose",
    "test:tools:browser": "JAIT_BROWSER_INTEGRATION=1 vitest run packages/gateway/src/tools/browser-tools-integration.test.ts --reporter=verbose",
    "lint": "bunx oxlint . && bun run lint:hooks",
    "lint:hooks": "bunx oxlint --react-plugin --allow all --deny react/rules-of-hooks apps/web/src",
    "typecheck": "bun run --filter '*' typecheck",
    "release:check": "node scripts/check-release-version-source.js",
    "healthcheck": "bun run release:check && bun run typecheck && bun run build && bun run test && bun run lint",
    "clean": "rm -rf packages/*/dist apps/*/dist node_modules/.cache"
  },
  "devDependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "trustedDependencies": [
    "node-pty"
  ],
  "overrides": {
    "@types/node": "^26.4.1"
  }
}
