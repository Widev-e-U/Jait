flowchart LR
  subgraph Clients["Clients"]
    WEB["Web UI (web-dist)"]
    CLI["@jait/cli"]
    API["API clients / @jait/api-client"]
    WS["WS control plane clients"]
    VOICE["Voice assistant (WS)"]
    MCP["MCP clients (/mcp, SSE)"]
    CHANNEL["WhatsApp channel (baileys)"]
  end

  subgraph Edge["Edge layer (fastify 5, port 18080 shared HTTP+WS)"]
    HTTP["HTTP routes (42 files)"]
    STATIC["@fastify/static (web-dist)"]
    WSPLANE["WsControlPlane (@fastify/websocket)"]
    AUTH["http-auth + jose JWT"]
    CORS["@fastify/cors + cookie"]
  end

  subgraph Security["Security layer"]
    CONSENT["ConsentManager (tool profiles)"]
    CONSEXEC["ConsentAwareExecutor"]
    TRUST["TrustEngine"]
    SANDBOX["SandboxManager"]
  end

  subgraph Core["Core domain services (75 files)"]
    SESSIONS["Session/Thread/Plan"]
    PROJECTS["Project/Repo/Watcher"]
    MEMORY["MemoryEngine + reminders"]
    SCHED["Scheduler + HookBus + cron"]
    COMMS["Email/Calendar/Notifications/MobilePush"]
    EXTRAS["Git/Preview/CodeGraph/Diagrams/DeviceRegistry"]
  end

  subgraph Providers["LLM providers"]
    REG["ProviderRegistry"]
    JP["JaitProvider"]
    ACP["AcpProvider (pi, external agents)"]
  end

  subgraph Tools["Tool layer (81 files)"]
    TREG["ToolRegistry (118 tools)"]
    REMOTE["RemoteToolExecutor"]
    NET["network-scan (LAN probes)"]
  end

  subgraph Surfaces["Surfaces"]
    TERM["Terminal (pty-broker, bun-pty/node-pty)"]
    FS["Filesystem/Remote-FS"]
    BROWSER["Browser (playwright)"]
    SCREEN["Screen share/record"]
  end

  subgraph Infra["Infrastructure"]
    DB[("SQLite (node:sqlite + drizzle-orm)")]
    SKILLS["Skills (67) + OpenClaw plugins (131)"]
    STATES["State dir (~/.jait)"]
    DOCKER["OS sandbox containers (Docker exec)"]
  end

  WEB --> STATIC
  WEB --> WSPLANE
  API --> HTTP
  WS --> WSPLANE
  VOICE --> WSPLANE
  MCP --> HTTP
  CHANNEL --> HTTP
  CLI --> HTTP

  HTTP --> AUTH
  AUTH --> SESSIONS
  HTTP --> TREG
  WSPLANE --> SESSIONS
  WSPLANE --> CONSEXEC

  CONSEXEC --> CONSENT
  CONSEXEC --> TRUST
  CONSEXEC --> TREG
  SANDBOX --> DOCKER

  TREG --> SURFACES_ARROWS["Surfaces"]
  TREG --> REMOTE
  TREG --> NET
  REMOTE --> TERM
  SURFACES_ARROWS --> TERM
  SURFACES_ARROWS --> FS
  SURFACES_ARROWS --> BROWSER
  SURFACES_ARROWS --> SCREEN

  SESSIONS --> DB
  MEMORY --> DB
  SCHED --> DB
  PROJECTS --> DB
  COMMS --> DB
  EXTRAS --> DB
  MEMORY --> SKILLS
  SESSIONS --> REG
  REG --> JP
  REG --> ACP
  SCHED --> COMMS
  PROJECTS --> EXTRAS

  DB --> STATES
  SKILLS --> STATES
  TREG --> CONSENT

  classDef edge fill:#dbeafe,stroke:#2563eb
  classDef core fill:#dcfce7,stroke:#16a34a
  classDef infra fill:#fef3c7,stroke:#d97706
  class HTTP,STATIC,WSPLANE,AUTH,CORS edge
  class SESSIONS,PROJECTS,MEMORY,SCHED,COMMS,EXTRAS core
  class DB,SKILLS,STATES,DOCKER infra
