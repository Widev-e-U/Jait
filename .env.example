# ── LLM Provider ──────────────────────────────────────────────
# Auto-detected: if OPENAI_API_KEY is set → openai, otherwise → ollama
# Override explicitly with: ollama | openai
# LLM_PROVIDER=openai

# ── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_MODEL=gpt-5
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Ollama (used when LLM_PROVIDER=ollama or no API key set) ─
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=CognitiveComputations/dolphin-mistral-nemo:12b

# ── OmniRoute (local OpenAI-compatible router: npm i -g omniroute) ─
# Selected per user via Settings → Jait LLM Backend → "OmniRoute".
# In Docker, localhost is the container — use http://host.docker.internal:20128/v1
# OMNIROUTE_BASE_URL=http://localhost:20128/v1
# API key is optional; OmniRoute serves keyless free-tier providers without one.
# OMNIROUTE_API_KEY=
# Model used when the UI has not picked one ("auto" lets OmniRoute route itself)
# OMNIROUTE_MODEL=auto
# Opt-in: route the Claude Code / Codex CLI agents through OmniRoute too.
# Leave unset unless you want their vendor subscriptions bypassed.
# JAIT_ACP_VIA_OMNIROUTE=1
# Opt-in: also hand CLI agents OmniRoute's own MCP server (routing, providers,
# combos, cache, memory). Requires OMNIROUTE_API_KEY — that endpoint always
# authenticates, unlike the inference API.
# JAIT_OMNIROUTE_MCP=1

# ── Server ────────────────────────────────────────────────────
# PORT=8000
# WS_PORT=18789
# HOST=0.0.0.0
# CORS_ORIGIN=http://localhost:3000
# LOG_LEVEL=info
# JWT_SECRET=jait-dev-secret-change-in-production
# HOOK_SECRET=jait-hook-secret-change-in-production
# HEARTBEAT_CRON=* * * * *
# CONTEXT_WINDOW=0
# JAIT_WEB_DIR=/absolute/path/to/apps/web/dist
# JAIT_DB_PATH=/absolute/path/to/jait.db

# ── Database Retention ────────────────────────────────────────
# Metadata retention is enabled by default. It removes replay/debug detail,
# not chat content. Set JAIT_RETENTION_ENABLED=false to opt out. Retention
# uses small yielding batches and never runs VACUUM automatically.
# Derived search-index noise is removed incrementally by default without deleting traces.
# JAIT_SEARCH_INDEX_CLEANUP_ENABLED=true
# JAIT_RETENTION_ENABLED=true
# JAIT_RETENTION_CONTEXT_FLOW_DAYS=90
# JAIT_RETENTION_TOOL_DETAIL_DAYS=90
# JAIT_RETENTION_TRANSIENT_ACTIVITY_DAYS=14
# JAIT_RETENTION_AUDIT_PAYLOAD_DAYS=90
# Full audit-row deletion is disabled when unset or 0.
# JAIT_RETENTION_AUDIT_ROW_DAYS=0
# JAIT_RETENTION_BATCH_SIZE=100
# JAIT_RETENTION_MAX_BATCHES=20
# JAIT_RETENTION_INITIAL_DELAY_MS=300000
# JAIT_RETENTION_INTERVAL_MS=86400000

# ── Disk Janitor ───────────────────────────────────────────────
# Reclaims stale Jait-managed worktrees, scratch directories, and sandbox
# disks. Branches are preserved by default so committed work remains recoverable.
# JAIT_DISK_JANITOR_ENABLED=true
# JAIT_JANITOR_WORKTREE_GRACE_DAYS=2
# JAIT_JANITOR_ORPHAN_WORKTREE_GRACE_DAYS=1
# JAIT_JANITOR_PRESERVE_BRANCHES=true
# JAIT_JANITOR_TEMP_SCRATCH_DAYS=3
# JAIT_JANITOR_SANDBOX_STORAGE_DAYS=1
# JAIT_JANITOR_INITIAL_DELAY_MS=120000
# JAIT_JANITOR_INTERVAL_MS=21600000

# ── Remote Node Mode ─────────────────────────────────────────
# Set on a secondary machine to expose its filesystem and terminal to
# the primary gateway without serving a local dashboard.
# JAIT_PRIMARY_GATEWAY=http://primary-gateway:8000
# JAIT_PRIMARY_TOKEN=
# JAIT_NODE_NAME=
# Defaults to true when JAIT_PRIMARY_GATEWAY is set. Set false only if
# this process should also expose a full gateway dashboard/API.
# JAIT_NODE_ONLY=true

# ── Windows VM Sandbox SSH (os.* Windows driver) ─────────────
# Credentials provisioned inside the dockur Windows VM (SSH_USERNAME /
# SSH_PASSWORD) that the os.screenshot/os.click/os.type/os.exec tools use to
# steer the VM. Must match what the VM was started with (windows.sandbox.start
# defaults to username "Docker" / password "admin" and provisions SSH with the
# same account). The VM's SSH is published on a free host port automatically.
# WINDOWS_SSH_USERNAME=Docker
# WINDOWS_SSH_PASSWORD=admin

# ── Web Search Providers (web.search tool) ───────────────────
# Auto priority: BRAVE_API_KEY -> PERPLEXITY/OPENROUTER -> XAI -> GEMINI -> MOONSHOT -> OPENAI_API_KEY
# If provider-specific API keys are missing, web.search falls back to OpenAI web_search.

# OpenAI web_search fallback/default
# OPENAI_WEB_SEARCH_MODEL=gpt-5

# Brave Search
# BRAVE_API_KEY=

# Perplexity (direct) or OpenRouter (Perplexity models)
# PERPLEXITY_API_KEY=
# OPENROUTER_API_KEY=
# PERPLEXITY_MODEL=sonar-pro
# PERPLEXITY_OPENROUTER_MODEL=perplexity/sonar-pro

# xAI Grok
# XAI_API_KEY=
# GROK_MODEL=grok-4-1212

# Google Gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Moonshot Kimi
# MOONSHOT_API_KEY=
# KIMI_BASE_URL=https://api.moonshot.ai/v1
# KIMI_MODEL=moonshot-v1-128k

# ── Faster Whisper (local STT) ───────────────────────────────
# URL of the local Faster Whisper HTTP server.
# Start with: cd packages/gateway/whisper-server && python server.py
# WHISPER_URL=http://localhost:8178

# ── Voice Assistant (OpenAI Realtime API) ────────────────────
# The "Hey Jait" wake word opens a real-time voice session using
# your existing OPENAI_API_KEY — no extra services needed.
# OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
# OPENAI_REALTIME_VOICE=alloy
# OPENAI_REALTIME_TURN_DETECTION=server_vad
# OPENAI_REALTIME_VAD_THRESHOLD=0.5
# OPENAI_REALTIME_PREFIX_PADDING_MS=300
# OPENAI_REALTIME_SILENCE_DURATION_MS=450
# OPENAI_REALTIME_SEMANTIC_EAGERNESS=auto

# ── Provider CLIs ─────────────────────────────────────────────
# CODEX_HOME=~/.codex
# ANTHROPIC_API_KEY=
# JAIT_ACP_PROVIDERS=
# JAIT_ACP_REGISTRY_URL=https://cdn.agentclientprotocol.com/registry/v1/latest/registry.json
# JAIT_ACP_REGISTRY_DISABLED=0
# JAIT_CODEX_LOGIN_COMMAND=codex
# Graphify is provisioned automatically under ~/.jait/runtime.
# JAIT_GRAPHIFY_COMMAND=/custom/path/to/graphify
# JAIT_GRAPHIFY_PYTHON=/custom/path/to/python3

# ── Browser tool/runtime ──────────────────────────────────────
# BROWSER_RUNTIME=auto
# BROWSER_HEADLESS=true
# BROWSER_LIVE_VIEW=true
# BROWSER_CHANNEL=
# BROWSER_FALLBACK_CHANNELS=chrome,chromium,msedge
# BROWSER_LAUNCH_TIMEOUT_MS=30000
# BROWSER_IGNORE_HTTPS_ERRORS=false
# Console flood protection: when a previewed page emits this many console
# messages within the window, capture pauses for the cooldown and resumes
# automatically. Protects the UI and agent context from console spam loops.
# BROWSER_CONSOLE_FLOOD_THRESHOLD=60
# BROWSER_CONSOLE_FLOOD_WINDOW_MS=2000
# BROWSER_CONSOLE_FLOOD_COOLDOWN_MS=30000
# WEB_FETCH_IGNORE_TLS_ERRORS=false

# ── Integrations ──────────────────────────────────────────────
# GITHUB_TOKEN=
# GITHUB_PAT=
# GITLAB_TOKEN=
# GITEA_TOKEN=
# AZURE_DEVOPS_PAT=
# BITBUCKET_TOKEN=
# JAIT_LOCATION=

# Firebase service-account JSON used for urgent Android question pushes.
# JAIT_FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
