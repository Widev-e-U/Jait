# Dependencies
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# Local e2e bootstrap cache (Playwright browser + rootless system libraries),
# created by scripts/setup-e2e-env.sh. Large and host-specific; never commit.
.cache/

# Environment
.env
*.env
.env.*
!*.env.example

# Build outputs
dist/
build/
web-dist/
*.egg-info/
*.tsbuildinfo

# TypeScript compiled output (emitted alongside .ts sources)
vitest.config.js
vitest.config.js.map
vitest.config.d.ts
vitest.config.d.ts.map
# Vite resolves vite.config.js BEFORE vite.config.ts, so a committed compiled
# copy silently shadows the real config (it once pinned sourcemap: true and
# dropped the /preview dev proxy). Never commit these.
apps/web/vite.config.js
apps/web/vite.config.js.map
apps/web/vite.config.d.ts
apps/web/vite.config.d.ts.map
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map
apps/*/src/**/*.js
apps/*/src/**/*.js.map
apps/*/src/**/*.d.ts
apps/*/src/**/*.d.ts.map
!apps/web/src/global.d.ts

# IDE
.idea/
.vscode/
.gemini/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Local agent transcripts
/flow.txt
/contextflow.txt
/ollama flow.txt

# Local agent state (Jait runtime db / todo state)
/jait.db
/todo.json

# Testing
.coverage
htmlcov/
.pytest_cache/
tests/e2e/test-results/
tests/e2e/playwright-report/
tests/e2e/.artifacts/

# Temp
temp-*/
.jait/shots/
playwright-report/

# App-specific generated files
apps/mobile/.expo/

# Local release signing material
/private/

# Firebase client config (project-specific)
apps/mobile/android/app/google-services.json

# Windows VM sandbox disk images (multi-GB, never commit)
docker/windows-sandbox-storage/

# Tauri desktop shell (standalone crate, cross-compiled for Windows)
apps/desktop/src-tauri/target/
apps/desktop/target/

# Local Tauri Windows cross-compile workdir / container build mirror (14GB+)
jait-win/

# Tauri build output (installers are staged via CI, never committed)
apps/desktop/dist/

# desktop shell test harness artifacts
apps/desktop/src-tauri/tests/harness/out/

# Private source recovery archives from managed worktree cleanup
.jait/worktree-recovery/

# Private downloaded scanner binaries and advisory database used for validation
.jait/security-engine-lab/

# Private local activation snapshots
.jait/security-runtime-*/

# Local scratch / validation artifacts (screenshots, patches, ad-hoc scripts,
# download stashes, investigation dirs). Keep only the tracked architecture map.
.jait/*
!.jait/architecture.mmd
